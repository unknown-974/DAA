#include<stdio.h>
#include<stdlib.h>
void swap(int*, int*);
void bubble_sort(int*, int);
int main()
{
        int *a;
        int n,i;
        printf("Bubble sort\n");
        printf("Enter the size of the array: ");
        scanf("%d",&n);
        a=(int*)malloc(n*sizeof(int));
        printf("Enter the array elements:");
        for(i=0;i<n;i++)
        {
                scanf("%d",&a[i]);
        }
        bubble_sort(a,n);
        printf("\nSorted Array\n");
        for(i=0;i<n;i++)
        {
                printf("%d\n",a[i]);
        }
}
void swap(int *a, int *b)
{
        int temp;
        temp=*a;
        *a=*b;
        *b=temp;
}
void bubble_sort(int* a,int n)
{
        int i,k,j;
        for(i=0;i<n-1;i++)
        {
                printf("\nPass %d:",i+1);
                for(j=0;j<n-1-i;j++)
                {
                        if(a[j]>a[j+1])
                        {
                                swap(&a[j],&a[j+1]);
                        }
                        for(k=0;k<n;k++)
                        {
                                printf("\t%d\t",a[k]);
                        }
                        printf("\n");

                }
        }
}
