#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int *x;
int N;

int place(int k, int i)
{
   int j;
    for ( j = 1; j < k; j++)
    {
        if (x[j] == i || abs(j - k) == abs(x[j] - i))
        {
            return 0;
        }
    }
    return 1;
}

void printBoard()
{
   int i,j;
    printf("Board:\n");
    for  (i = 1; i <= N; i++)
    {
        for ( j = 1; j <= N; j++)
        {
            if (x[i] == j)
            {
                printf("Q ");
            } else
            {
                printf("* ");
            }
        }
        printf("\n");
    }

    printf("Solution Vector: [");
    for ( i = 1; i <= N; i++)
    {
        printf("%d", x[i]);
        if (i != N)
           printf(", ");
    }
    printf("]\n\n");
}

void NQueens(int k)
{
   int i;
    for ( i = 1; i <= N; i++)
    {
        if (place(k, i))
        {
            x[k] = i;
            if (k == N)
            {
                printBoard();
            }
            else
            {
                NQueens(k + 1);
            }
        }
    }
}

int main() {
    printf("Enter the number of rows: ");
    scanf("%d", &N);
    x = (int *)malloc(sizeof(int) * (N + 1));
    printf("Solutions:\n");
    NQueens(1);
    free(x);
    return 0;
}
