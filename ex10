#include <stdio.h>
#include <limits.h>

#define MAX 10

int n, visited[MAX], minCost = INT_MAX;
int graph[MAX][MAX], path[MAX], bestPath[MAX];

void tsp(int pos, int count, int cost) {
    int i;

    if (count == n && graph[pos][0]) {
        int totalCost = cost + graph[pos][0];
        if (totalCost < minCost) {
            minCost = totalCost;
            for (i = 0; i < n; i++)
                bestPath[i] = path[i];
        }
        return;
    }

    for (i = 0; i < n; i++) {
        if (!visited[i] && graph[pos][i]) {
            visited[i] = 1;
            path[count] = i;
            tsp(i, count + 1, cost + graph[pos][i]);
            visited[i] = 0;
        }
    }
}

int main() {
    int i,j,k;
    printf("Enter number of cities: ");
    scanf("%d", &n);

    printf("Enter cost matrix:\n");
    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++)
            scanf("%d", &graph[i][j]);

    visited[0] = 1;
    path[0] = 0;
    tsp(0, 1, 0);

    printf("Minimum cost: %d\n", minCost);
    printf("Path: ");
    for (k = 0; k < n; k++)
        printf("%d -> ", bestPath[k]);
    printf("0\n"); // back to the start

    return 0;
}
