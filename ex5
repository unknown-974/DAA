#include <stdio.h>
void comparisonCountingSort(int A[], int n, int S[])
{
        int Count[n],i,j;
        for ( i = 0; i < n; i++)
        {
                Count[i] = 0;
        }
        for (i = 0; i < n - 1; i++)
        {
                for ( j = i + 1; j < n; j++)
                {
                        if (A[i] < A[j])
                        {
                                Count[j]++;
                        }
                        else
                        {
                                Count[i]++;
                        }
                }
        }
        for ( i = 0; i < n; i++)
        {
                S[Count[i]] = A[i];
        }
}
